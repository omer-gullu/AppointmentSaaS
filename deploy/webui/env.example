# /opt/appointmentsaas/webui.env
# systemd EnvironmentFile. Copy to webui.env and replace CHANGE_ME.
# Deploy creates webui.env only when it is missing (never overwrites secrets).
# Deploy always forces ApiBaseUrl to loopback — do not use a public hostname.

ASPNETCORE_ENVIRONMENT=Production
ApiBaseUrl=http://127.0.0.1:5294

ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=appointmentsaas;Username=app;Password=CHANGE_ME
