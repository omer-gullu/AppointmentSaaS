# /opt/appointmentsaas/api.env
# systemd EnvironmentFile. Copy to api.env and replace CHANGE_ME.
# Deploy creates api.env only when it is missing (never overwrites secrets).

ASPNETCORE_ENVIRONMENT=Production

ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=appointmentsaas;Username=app;Password=CHANGE_ME
TokenOptions__SecurityKey=CHANGE_ME_MIN_32_CHARS
EncryptionSettings__AesKey=CHANGE_ME_BASE64_32_BYTES
WebhookSecurity__N8nAuthToken=CHANGE_ME

EvolutionApi__BaseUrl=http://127.0.0.1:8080
EvolutionApi__GlobalApiKey=CHANGE_ME
EvolutionApi__WebhookUrl=http://127.0.0.1:5678/webhook/CHANGE_ME
EvolutionApi__DefaultInstance=CHANGE_ME
